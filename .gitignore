# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# AI / agent local files
CLAUDE.md
.claude/

# Data (managed by DVC starting from Phase 1)
# data/raw/ is governed by DVC's per-folder .gitignore (written by `dvc add`);
# the broad rule was removed so the versioned creditcard.csv.dvc pointer stays visible to Git.
data/processed/*
!data/processed/.gitkeep

# ML / test / lint artifacts
.pytest_cache/
.ruff_cache/
# Evidently drift reports, rewritten on every monitoring run (Phase 8). Scoped
# to the subdirectory on purpose: reports/metrics.json and
# reports/validation.json are TRACKED and read by CI's model-quality gate from
# a bare checkout, so a blanket reports/ rule would break the build.
reports/drift/
mlruns/
mlflow.db
# Prediction logs written by the API at runtime (Phase 4). Operational
# output, not versioned content — same rationale as mlruns/ above.
logs/
# Local training artifacts (confusion_matrix.png, pr_curve.png). The permanent
# copy of each run's artifacts lives in MLflow's own store, not here.
#
# ANCHORED to the repository root, and that leading slash is load-bearing.
# Unanchored, `models/` matches a directory of that name at ANY depth, and it
# silently swallowed deploy/model/code/src/models/ — four real files of the
# exported artifact, register.py among them, which is where the FraudModel
# class the bundle unpickles is defined. The bundle would have been committed
# incomplete, and nothing would have said so.
/models/

# Notebooks (checkpoints)
.ipynb_checkpoints/

# Local docker env overrides; docker/.env.example is the tracked template.
docker/.env
