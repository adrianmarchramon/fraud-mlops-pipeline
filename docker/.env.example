# Environment for docker compose. Copy to docker/.env to override locally;
# docker/.env is git-ignored, this template is tracked.
#
# No secrets belong in this file. Phase 6 introduces real CI/CD credentials,
# which will come from the runner's secret store, never from here.

# Where the API looks for the Model Registry. "mlflow" is the compose service
# name, resolved by Compose's internal DNS — no IP address is ever hardcoded.
# src/config.py falls back to sqlite:///mlflow.db when this is unset, which is
# what keeps `make serve` working outside containers.
MLFLOW_TRACKING_URI=http://mlflow:5000
